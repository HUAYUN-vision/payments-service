NODE_ENV=development
PORT=3000
GLOBAL_PREFIX=api
LOG_LEVEL=debug
CORS_ORIGIN=*
SWAGGER_ENABLED=true

# --- database ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=payments
DB_USER=postgres
DB_PASSWORD=postgres
DB_LOGGING=false

# --- clients: project:key через запятую (ключ >= 16 символов) ---
# ключ передаётся в X-API-Key и им же подписываются уведомления (HMAC-SHA256)
API_KEYS=my-shop:change-me-to-long-random-secret

# --- callbacks ---
CALLBACK_TIMEOUT_MS=10000
CALLBACK_MAX_ATTEMPTS=12

# --- YooKassa ---
# вебхук в кабинете YooKassa: https://<host>/api/v1/yookassa/webhook (payment.succeeded, payment.canceled)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# --- WeChat Pay (APIv3, Native) ---
WECHAT_APPID=
WECHAT_MCHID=
WECHAT_API_V3_KEY=
WECHAT_NOTIFY_URL=https://example.com/api/v1/wechat/callback
# apiclient_cert.pem + apiclient_key.pem
WECHAT_CERTS_DIR=data/keys
